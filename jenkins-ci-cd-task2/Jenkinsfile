pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        IMAGE_NAME = 'devops-task2-web'
        CONTAINER_NAME = 'task2-jenkins-web'
        HOST_PORT = '8090'
    }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'docker build -t "$IMAGE_NAME:$BUILD_NUMBER" .'
            }
        }

        stage('Test') {
            steps {
                sh 'sh tests/test_site.sh'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f "$CONTAINER_NAME" || true
                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        --restart unless-stopped \
                        -p "$HOST_PORT:80" \
                        "$IMAGE_NAME:$BUILD_NUMBER"
                    test "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME")" = "true"
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Website deployed to http://localhost:8090'
        }
        failure {
            echo 'FAILED: Read the Console Output for the error.'
        }
    }
}
